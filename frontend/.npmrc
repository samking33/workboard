# package.json pins pnpm 11.13.1 via "packageManager". Newer pnpm releases treat
# that as a hard requirement and abort with:
#   "This project is configured to use 11.13.1 of pnpm. Your current pnpm is vX"
# which blocks builds on any machine with a different 11.x — including CI and
# the deploy box.
#
# The lockfile, not the pnpm patch version, is what pins the dependency tree, and
# it is compatible across 11.x. So warn on a mismatch instead of failing.
# Older pnpm versions ignore this key.
pm-on-fail=warn
