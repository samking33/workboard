[Unit]
Description=FSOC
After=network.target mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=vikunja
Group=vikunja
WorkingDirectory=/var/www/vikunja
ExecStart=/var/www/vikunja/vikunja

# Secrets live here, not in the unit file or the config. 0640 root:vikunja.
EnvironmentFile=/etc/vikunja/vikunja.env

Restart=always
RestartSec=5

# The process only ever needs its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/vikunja
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
