# NOTE ON THE VIKUNJA_ PREFIX
# These variable names keep the upstream prefix on purpose. It is the config
# namespace the binary reads (viper's env prefix), not branding shown anywhere
# in the app. Renaming it would mean touching the Dockerfile, magefile, CI and
# the e2e harness, where a single miss fails silently at config load.
#
# Copy to /etc/vikunja/vikunja.env on the server, fill in, then:
#   chown root:vikunja /etc/vikunja/vikunja.env && chmod 640 /etc/vikunja/vikunja.env
# It holds the database and mail passwords, so it must not be world-readable
# and must never be committed.

# ---- required ---------------------------------------------------------------

# Exact public origin including scheme and trailing slash. Logins and the links
# in outgoing mail are built from this; a mismatch breaks both.
VIKUNJA_SERVICE_PUBLICURL=https://tasks.example.com/

# Signs session tokens. Generate once with:  openssl rand -hex 32
# If unset, FSOC generates a random one per start, which logs everyone out
# on every restart and every deploy.
VIKUNJA_SERVICE_SECRET=

# Data directory: database file (sqlite only), uploads, logs.
VIKUNJA_SERVICE_ROOTPATH=/var/www/vikunja
VIKUNJA_FILES_BASEPATH=/var/www/vikunja/files

# ---- database ---------------------------------------------------------------
# On Hostinger these come from hPanel -> Databases -> MySQL. The host is usually
# localhost; the user and database names are prefixed with your account id.
VIKUNJA_DATABASE_TYPE=mysql
VIKUNJA_DATABASE_HOST=127.0.0.1:3306
VIKUNJA_DATABASE_DATABASE=vikunja
VIKUNJA_DATABASE_USER=vikunja
VIKUNJA_DATABASE_PASSWORD=

# ---- mail -------------------------------------------------------------------
VIKUNJA_MAILER_ENABLED=true
VIKUNJA_MAILER_HOST=smtp.hostinger.com
VIKUNJA_MAILER_PORT=587
VIKUNJA_MAILER_USERNAME=
VIKUNJA_MAILER_PASSWORD=
VIKUNJA_MAILER_FROMEMAIL=

# ---- oversight panel (optional, separate process) ---------------------------
# Only set if you run admin-panel.py. It reads the same database.
ADMIN_PANEL_PASSWORD=
